# Copy to .env and set the credentials for your environment.
DATABASE_URL=
# Optional isolated local database for integration tests.
COSTFERN_TEST_DATABASE_URL=

# Shopify CLI supplies these during app dev. Set them explicitly for hosting.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products

# Shopify App Pricing entitlement lookup.
SHOPIFY_APP_HANDLE=costfern
SHOPIFY_APP_GID=
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=

# Optional exact development-store domain for the private $0 test plan.
COSTFERN_PRICING_TEST_SHOP=
